# Copy to .env and fill in the keys you have. The server loads .env from the project root.
# Providers are tried in this order: OpenAI, then Gemini, then Mistral. A missing key just skips that provider.
OPENAI_API_KEY=your-openai-key
GEMINI_API_KEY=your-gemini-key
MISTRAL_API_KEY=your-mistral-key

# Optional: onboard to your own repository instead of the bundled sample_repo.
# ONBOARDING_REPO_ROOT=C:/path/to/your/repo
